# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# Подключение к PostgreSQL (в docker-compose хост называется db).
# Без Docker и PostgreSQL можно хранить всё в файле: DATABASE_URL=sqlite+aiosqlite:///bot.sqlite3
DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/learnenglish

# Часовой пояс по умолчанию для напоминаний
DEFAULT_TIMEZONE=Europe/Moscow

# Необязательно: ключ Claude API для умной проверки переводов и сочинений.
# Если пусто, бот проверяет ответы по готовым правильным вариантам.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина размышлений: low (быстро и дёшево) | medium | high
ANTHROPIC_EFFORT=low

# Голос для озвучки аудирования (edge-tts)
TTS_VOICE=en-US-AriaNeural
# Необязательно: прокси для озвучки, если сервис Microsoft недоступен напрямую
TTS_PROXY=
